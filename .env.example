# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
COOKIE_SECRET=your_cookie_secret_key_change_in_production

# Database Configuration
# Uses Node.js native SQLite database file path (or :memory: for testing)
DATABASE_PATH=./art_studio.db

# Seed Data Path (optional override, defaults to ./seedData/seed.json)
SEED_DATA_PATH=./seedData/seed.json
